# ─────────────────────────────────────────────────────────────────────────────
# EduSphere Backend — environment contract
#
# TRD §10.2 is the single source of truth for this file. All 25 variables in
# that matrix appear below; `src/config/env.js` validates them through Zod and
# calls process.exit(1) on a miss, so a name that drifts from the matrix takes
# the process down at boot rather than degrading quietly.
#
# Copy to .env before running anything: `cp .env.example .env`
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# CORS_ORIGIN lists the origins permitted to call this API and becomes
# comma-separated the moment staging appears. FRONTEND_URL is the single base
# every email link is built from and must resolve to exactly one address.
# They hold the same value in a single-origin deployment and are still two
# variables — collapsing them makes verification links a concatenated string.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Ungated, /api-docs publishes every route, schema, and example publicly.
SWAGGER_ENABLED=true

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/edusphere?schema=public"

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379"

# Security
# The two JWT secrets must be DISTINCT. Signing both token classes with one key
# lets a refresh token be presented as an access token (TRD §7).
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-key-replace-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Storage Integration (AWS / Cloudinary)
# Conditionally required, and env.js must branch on this switch: s3 needs the
# four AWS_* keys, cloudinary needs CLOUDINARY_URL, and no environment needs
# both. Marking all five optional accepts a deployment whose selected provider
# has no credentials and fails on the first upload (TRD §10.2).
STORAGE_PROVIDER="cloudinary"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="edusphere-media-storage"

# Email Integration (SendGrid / Brevo)
# Provider-neutral names on purpose — a BREVO_-prefixed key defeats the
# EMAIL_PROVIDER switch sitting next to it.
EMAIL_PROVIDER="brevo"
EMAIL_API_KEY="your-email-api-key"
EMAIL_FROM="noreply@edusphere.example.com"
EMAIL_FROM_NAME="EduSphere"
# HMAC key the inbound delivery webhook verifies the raw body against. The
# signature IS the authentication for POST /webhooks/email (TRD §6.11).
EMAIL_WEBHOOK_SECRET=""

# Test Environment
# Read by the Day 15 test setup, which truncates tables between suites. Fail
# explicitly when these are absent rather than falling back to DATABASE_URL —
# that fallback is correct in CI and truncates the developer's own database
# everywhere else (TRD §9.2).
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/edusphere_test?schema=public"
REDIS_URL_TEST="redis://localhost:6379/1"
