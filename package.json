{
  "name": "edusphere-backend",
  "version": "1.0.0",
  "description": "EduSphere E-Learning & Assessment Platform Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node src/database/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.14.0",
    "pino": "^8.16.2",
    "pino-http": "^8.5.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
